SENVIOK_API_KEY=svk_live_...

# send_email
SENVIOK_FROM_EMAIL="Acme <hello@acme.com>"
SENVIOK_TO_EMAIL=you@example.com

# send_sms / send_whatsapp
SENVIOK_FROM_SMS=Senviok
SENVIOK_FROM_WHATSAPP=Senviok
SENVIOK_TO_PHONE=+2348012345678

# domains (optional — example lists domains without this)
SENVIOK_DOMAIN=mail.acme.com

# audiences (optional)
SENVIOK_CONTACT_EMAIL=ada@example.com

# suppressions (optional)
SENVIOK_SUPPRESSION_EMAIL=bounce@example.com

# list_messages (optional filters)
# SENVIOK_CHANNEL=email
# SENVIOK_STATUS=delivered

# webhooks (optional — example lists webhooks without this)
SENVIOK_WEBHOOK_URL=https://example.com/webhooks/senviok
